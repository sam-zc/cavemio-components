{
  "name": "cavemio-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run storybook",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/clean-generated.ts && shadcn build && node scripts/build.ts && node scripts/validate.ts",
    "validate": "node scripts/validate.ts",
    "serve": "node scripts/serve.ts",
    "test": "node --test lib/*.test.ts",
    "test:browser": "playwright test",
    "verify:install": "node scripts/verify-install.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.57.0",
    "shadcn": "4.21.5",
    "shaka-player": "^5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "motion": "14.2.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
